generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Watch {
  id               String       @id @default(cuid())
  marque           String
  modele           String
  reference        String?
  calibre          String?
  diametre         Float?
  etat             String       @default("Bon")
  fullSet          Boolean      @default(false)
  statut           String       @default("EN_ATTENTE")
  notes            String?
  imageUrl         String?
  prixMarche       Float?
  dateRevision     DateTime?
  dateMiseEnStock  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  achat            Achat?
  vente            Vente?
  photos           WatchPhoto[]
}

model Achat {
  id              String   @id @default(cuid())
  watchId         String   @unique
  watch           Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  prixMontre      Float    @default(0)
  fraisProxy      Float    @default(0)
  fraisPort       Float    @default(0)
  fraisReparation Float    @default(0)
  fraisDouane     Float    @default(0)
  coutTotal       Float    @default(0)
  dateAchat       DateTime @default(now())
  fournisseur     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vente {
  id          String   @id @default(cuid())
  watchId     String   @unique
  watch       Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  prixVente   Float
  plateforme  String?
  acheteur    String?
  dateVente   DateTime @default(now())
  benefice    Float    @default(0)
  marge       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WatchPhoto {
  id        String   @id @default(cuid())
  watchId   String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  url       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model Client {
  id               String     @id @default(cuid())
  nom              String
  prenom           String?
  email            String?
  telephone        String?
  instagram        String?
  statut           String     @default("PROSPECT")
  budgetMax        Float?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  wishlist         WishItem[]
}

model WishItem {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  marque    String
  modele    String?
  priorite  String   @default("MOYENNE")
  notes     String?
  createdAt DateTime @default(now())
}
